# ConvoHatch chatbot service (apps/chatbot)
# Copy to apps/chatbot/.env.local for local development, or set these in your host's settings.
# Every value is read on the server only. Never prefix any of them with NEXT_PUBLIC_.

# --- Database (required) ---------------------------------------------------------------------
# Without it, the widget shows "The chat is unavailable" and stores nothing.
#   Local development:  pglite:./.data/pglite   (embedded PostgreSQL in a folder; no install needed)
#   Production:         postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require   (any managed PostgreSQL)
# Embedded "pglite:" databases are refused on Vercel, where files don't persist.
DATABASE_URL=pglite:./.data/pglite
# Optional: connections per server instance (default 5). Keep low on serverless hosts.
DATABASE_POOL_MAX=

# --- Public address of this app (for installation snippets) --------------------------------
# Where this app is deployed, e.g. https://chat.your-domain.com. Snippets show a placeholder until set.
WIDGET_PUBLIC_BASE_URL=

# --- AI answers (optional) ------------------------------------------------------------------
# Without a key, the widget says live AI is unavailable and gives automatic answers from each
# client's approved FAQs, hours, and services only. Get a key at https://console.anthropic.com
# and set a monthly spend limit there. Usage is billed to your Anthropic account.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5).
WIDGET_AI_MODEL=

# --- Lead email notifications (required before a real client goes live) ------------------------
# Email via Resend (https://resend.com). The sender must be on a domain verified in Resend.
# Without these, leads are still stored and are sent by the retry job once configured.
RESEND_API_KEY=
# e.g. "ConvoHatch Leads <leads@your-domain.com>"
LEAD_NOTIFY_FROM_EMAIL=
# Optional: attempts before a notification is marked gave_up (default 8, backing off up to 6 hours).
WIDGET_NOTIFY_MAX_ATTEMPTS=

# --- Scheduled jobs --------------------------------------------------------------------------
# Protects GET /api/widget/cron (notification retries + data retention). The endpoint is disabled
# until this is set. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Abuse and cost limits (optional; defaults shown) -----------------------------------------
# Salt for hashing visitor IP addresses before they're used as rate-limit keys. Set a long random value.
WIDGET_HASH_SECRET=
# Per visitor (hashed IP), per client:
WIDGET_VISITOR_MESSAGES_PER_10_MIN=20
WIDGET_VISITOR_CONVERSATIONS_PER_HOUR=10
WIDGET_VISITOR_LEADS_PER_HOUR=5
# Per conversation:
WIDGET_MAX_MESSAGES_PER_CONVERSATION=30
# Per client per UTC day (a client's "limits" setting overrides these):
WIDGET_CLIENT_DAILY_CONVERSATIONS=500
WIDGET_CLIENT_DAILY_AI_REPLIES=400
WIDGET_CLIENT_DAILY_LEADS=100
# Across all clients per UTC day: hard ceiling on AI calls.
WIDGET_GLOBAL_DAILY_AI_REPLIES=2000

# --- Retention (optional; defaults shown) ----------------------------------------------------
WIDGET_CONVERSATION_RETENTION_DAYS=30
WIDGET_LEAD_RETENTION_DAYS=365
