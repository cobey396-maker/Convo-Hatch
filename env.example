# ConvoHatch demo-request delivery
# ---------------------------------
# The "Request a Demo" form is disabled until ONE delivery option below is configured.
# These values are read on the server only. Never prefix them with NEXT_PUBLIC_.

# Option A: Email via Resend (https://resend.com)
# All three values are required for this option.
RESEND_API_KEY=
# Inbox that should receive demo requests
DEMO_REQUEST_TO_EMAIL=
# Sender on a domain you have verified in Resend, e.g. "ConvoHatch <requests@your-domain.com>"
DEMO_REQUEST_FROM_EMAIL=

# Option B: Webhook (Zapier, Make, n8n, a CRM, or your own endpoint)
# Used only when Option A is not fully configured. Must be an https:// URL.
DEMO_REQUEST_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" so your endpoint can verify requests
DEMO_REQUEST_WEBHOOK_SECRET=

# ConvoHatch site assistant (chat button in the corner)
# ------------------------------------------------------
# Without a key, the assistant answers from scripted replies built from the site copy.
# With a key, it uses Claude (claude-opus-5) and falls back to scripted replies on any error.
# Get a key at https://console.anthropic.com. Usage is billed to your Anthropic account.
ANTHROPIC_API_KEY=
# Optional: maximum AI replies per server instance per day (default 300). After that, scripted replies are used.
SITE_ASSISTANT_DAILY_LIMIT=
